# — Obligatoire —
# Adresse publique du site (canonical, sitemap, JSON-LD). Sans slash final.
NEXT_PUBLIC_SITE_URL=https://autodan.fr
# Secret du lien de gestion : https://<site>/gestion/<ADMIN_TOKEN>  (32+ caractères, ex. `openssl rand -hex 24`)
ADMIN_TOKEN=
# Créé automatiquement par Vercel quand on connecte un store Blob au projet.
BLOB_READ_WRITE_TOKEN=

# — Tally (porte 1) — voir docs/TALLY.md
NEXT_PUBLIC_TALLY_FORM_ID=
TALLY_SIGNING_SECRET=

# — Umami (statistiques) — voir docs/UMAMI.md
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optionnels :
UMAMI_API_KEY=
UMAMI_SHARE_URL=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# NEXT_PUBLIC_UMAMI_DOMAINS=autodan.fr
# UMAMI_API_URL=            # seulement pour un Umami auto-hébergé

# — Alerte e-mail à chaque message (optionnel, Resend gratuit) —
RESEND_API_KEY=
NOTIFY_EMAIL=autodancontact@gmail.com
# RESEND_FROM=Site Autodan <site@autodan.fr>   # domaine vérifié chez Resend

# — Optionnel — secret qui nomme le dossier privé (messages, brouillons) dans le Blob.
# Par défaut dérivé de BLOB_READ_WRITE_TOKEN ; fixez-le si vous comptez régénérer ce token.
# DATA_KEY=
